<?xml version="1.0"?>
<model>
  <name>iris_vision_camera</name>
  <version>1.0</version>
  <sdf version='1.6'>iris_vision_camera.sdf</sdf>

  <author>
    <name>VUAV Team</name>
    <email>user@example.com</email>
  </author>

  <description>
    Iris quadcopter with vision plugin (External Vision for EKF2) and
    a downward-facing camera sensor for Visual Odometry.
    Based on PX4 iris_vision with added Gazebo camera plugin
    publishing to /camera/image_raw (640x480 @ 30fps).
  </description>
</model>
