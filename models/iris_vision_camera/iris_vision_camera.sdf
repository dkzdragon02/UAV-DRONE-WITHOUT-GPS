<?xml version='1.0'?>
<sdf version='1.6'>
  <!--
    iris_vision_camera — iris_vision + downward-facing camera for Visual Odometry

    Kết hợp:
    1. iris_vision plugin (cung cấp GT vision pose cho EKF2)
    2. Camera sensor Gazebo (publish /camera/image_raw cho vision_node.py)

    Topic: /camera/image_raw (sensor_msgs/msg/Image)
    Resolution: 640x480 @ 30fps
  -->
  <model name='iris_vision_camera'>

    <!-- ════════ Vision Plugin (same as iris_vision) ════════ -->
    <plugin name="vision_plugin" filename="libgazebo_vision_plugin.so">
      <robotNamespace></robotNamespace>
      <pubRate>30</pubRate>
      <randomWalk>0.1</randomWalk>
      <noiseDensity>0.01</noiseDensity>
      <corellationTime>60.0</corellationTime>
    </plugin>

    <!-- ════════ Base Iris Model ════════ -->
    <include>
      <uri>model://iris</uri>
    </include>

    <!-- ════════ Downward Camera Link ════════ -->
    <link name='camera_link'>
      <pose>0.05 0 -0.04 0 1.5708 0</pose>
      <!-- Positioned under body, pointing down (90° pitch) -->

      <inertial>
        <mass>0.020</mass>
        <inertia>
          <ixx>4.15e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.407e-6</iyy>
          <iyz>0</iyz>
          <izz>2.407e-6</izz>
        </inertia>
      </inertial>

      <collision name='camera_collision'>
        <geometry>
          <box>
            <size>0.02 0.02 0.02</size>
          </box>
        </geometry>
      </collision>

      <visual name='camera_visual'>
        <geometry>
          <box>
            <size>0.02 0.02 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- ════════ Camera Sensor ════════ -->
      <sensor name='downward_camera' type='camera'>
        <camera name='vo_camera'>
          <horizontal_fov>1.3962634</horizontal_fov>  <!-- ~80° FOV -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>

        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>

        <!-- Gazebo ROS Camera Plugin → publishes to /camera/image_raw -->
        <plugin name='camera_controller' filename='libgazebo_ros_camera.so'>
          <ros>
            <namespace></namespace>
            <remapping>image_raw:=/camera/image_raw</remapping>
            <remapping>camera_info:=/camera/camera_info</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
          <hack_baseline>0.0</hack_baseline>
        </plugin>
      </sensor>
    </link>

    <!-- ════════ Fixed Joint: Camera → Iris Base ════════ -->
    <joint name='camera_joint' type='fixed'>
      <child>camera_link</child>
      <parent>iris::base_link</parent>
    </joint>

  </model>
</sdf>
