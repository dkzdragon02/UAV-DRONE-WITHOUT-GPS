[flake8]
# Maximum line length
max-line-length = 100

# Exclude patterns
exclude =
    .git,
    __pycache__,
    build,
    install,
    dist,
    *.egg,
    .venv,
    venv

# Ignore specific errors
ignore =
    E203,  # whitespace before ':'
    E501,  # line too long (handled by black)
    W503,  # line break before binary operator
    E402,  # module level import not at top of file (ROS2 needs this)

# Per-file ignores
per-file-ignores =
    __init__.py:F401  # unused imports in __init__.py

# Maximum complexity
max-complexity = 15

